// ==============================================================================
// Prisma Schema for SC(S)CO Digital Campus
// Shri Chhatrapati Shivaji College, Omerga (Bharat Shikshan Sanstha)
// PostgreSQL Database Schema for ERP, Academic Governance, and Portals
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  STAFF
  GUEST
}

enum RoleCategory {
  management
  administration
  teaching_senior
  teaching_junior
  non_teaching
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(GUEST)
  avatarUrl     String?
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student?
  teacher       Teacher?
  parent        Parent?
  staff         Staff?
  auditLogs     AuditLog[]
}

model Person {
  id            String        @id @default(uuid())
  name          String
  marathiName   String?
  designation   String
  roleCategory  RoleCategory
  department    String?
  qualification String?
  phone         String?
  email         String?
  address       String?
  photoUrl      String?
  biography     String?
  displayOrder  Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Department {
  id            String    @id @default(uuid())
  name          String    @unique
  marathiName   String
  faculty       String    // Science, Arts, Commerce, Vocational
  hodName       String
  hodPhone      String?
  description   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  courses       Course[]
  teachers      Teacher[]
}

model Course {
  id            String    @id @default(uuid())
  name          String
  level         String    // Junior College, Undergraduate, Postgraduate, Ph.D.
  faculty       String    // Arts, Science, Commerce, Vocational
  duration      String
  intake        Int
  eligibility   String
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  isNep2020     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  students      Student[]
  subjects      Subject[]
  feeStructures FeeStructure[]
}

model Subject {
  id            String    @id @default(uuid())
  name          String
  code          String    @unique
  credits       Int       @default(4)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  createdAt     DateTime  @default(now())

  attendance    AttendanceRecord[]
  marks         MarksRecord[]
}

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  rollNumber    String    @unique
  abcId         String?   // Academic Bank of Credits ID
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  academicYear  String    @default("2026-27")
  semester      Int       @default(1)
  category      String    @default("Open") // Open, SC, ST, OBC, etc.
  parentId      String?
  parent        Parent?   @relation(fields: [parentId], references: [id])
  createdAt     DateTime  @default(now())

  attendance    AttendanceRecord[]
  marks         MarksRecord[]
  fees          FeePayment[]
  certificates  Certificate[]
}

model Teacher {
  id            String      @id @default(uuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  designation   String
  qualification String
  createdAt     DateTime    @default(now())
}

model Parent {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  occupation    String?
  address       String?
  createdAt     DateTime  @default(now())

  students      Student[]
}

model Staff {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  section       String    // Administration, Library, Laboratory, Support
  designation   String
  createdAt     DateTime  @default(now())
}

model AttendanceRecord {
  id            String    @id @default(uuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       Subject   @relation(fields: [subjectId], references: [id])
  date          DateTime  @default(now())
  status        String    // PRESENT, ABSENT, LEAVE
}

model MarksRecord {
  id            String    @id @default(uuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       Subject   @relation(fields: [subjectId], references: [id])
  examName      String    // Internal, Mid-Term, University Final
  marksObtained Float
  maxMarks      Float     @default(100)
  createdAt     DateTime  @default(now())
}

model FeeStructure {
  id            String    @id @default(uuid())
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  openEbc       Float
  scSt          Float
  obcSeber      Float
  paying        Float
  academicYear  String    @default("2026-27")
}

model FeePayment {
  id            String    @id @default(uuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  receiptNumber String    @unique
  amount        Float
  category      String
  paymentMode   String    @default("ONLINE")
  createdAt     DateTime  @default(now())
}

model Notice {
  id            String    @id @default(uuid())
  title         String
  category      String
  audience      String    @default("ALL")
  content       String
  isPinned      Boolean   @default(false)
  date          DateTime  @default(now())
}

model Certificate {
  id                String    @id @default(uuid())
  certificateNumber String    @unique
  verificationCode  String    @unique
  studentId         String
  student           Student   @relation(fields: [studentId], references: [id])
  courseName        String
  type              String
  issueDate         DateTime  @default(now())
  gradeOrMarks      String
  isValid           Boolean   @default(true)
  issuedBy          String
}

model AuditLog {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  action        String
  details       String
  ipAddress     String?
  timestamp     DateTime  @default(now())
}
